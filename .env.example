# Copy to `.env` and fill in real values. Never commit the real `.env`.

APP_ENV=development
APP_NAME="Supply Chain Planning Platform"

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_JSON=false

# Local dependency-free development: SQLite (default if unset).
# DATABASE_URL=sqlite+aiosqlite:///./supply_chain.db
#
# Containerized / staging / production (see docker-compose.yml):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supply_chain
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Which reasoning engine the 4 LLM-calling agents use: "groq" (cloud, default)
# or "ollama" (fully local, no API key/quota - requires `ollama serve` running
# locally with OLLAMA_MODEL already pulled). Switching is a one-line change.
LLM_PROVIDER=groq

# Groq reasoning engine - required starting with the Supply Planning Agent
# when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_RETRIES=3

# Local Ollama reasoning engine - used when LLM_PROVIDER=ollama. Model must
# already be pulled (`ollama pull mistral`). mistral is recommended over
# smaller models like phi3 for more reliable structured-output/tool-calling.
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.1

# Phase 2 toggle. Fleet Assignment/Route Planning/ETA Prediction are built -
# set to true to enable them (adds 3 nodes to the graph and starts writing
# real Shipment rows with vehicle assignments). Default false reproduces the
# original 9-node Phase 1 graph unchanged.
FLEET_MODULE_ENABLED=false

CORS_ALLOW_ORIGINS=["*"]

# Google Gemini (AI Studio) - free-tier cloud alternative to Groq (per-minute rate
# limits rather than a flat daily token cap). Get a free key at
# https://aistudio.google.com/apikey. Used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# Lowered to 0.0 by default for determinism/idempotency - identical scope+data+engine
# should produce a stable result. The primary idempotency guarantee is the
# scope+data+engine cache in app/agents/graph.py; this is a secondary measure.
GROQ_TEMPERATURE=0.0
GEMINI_TEMPERATURE=0.0
OLLAMA_TEMPERATURE=0.0
